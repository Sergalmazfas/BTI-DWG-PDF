; === BTI_FULL_PROCESS.scr ===
; Главный сценарий обработки DWG для БТИ
; Загружает LISP-библиотеки и запускает обработку

; Шаг 1: Явная загрузка LISP-библиотек
(load "BTI_PROCESS.lsp")
(load "BTI_MARKERS.lsp")

; Шаг 2: Запуск основной функции обработки
(BTI_PROCESS)

; Шаг 3: Отладочное сообщение для логов Forge
(princ "\n[BTI_FULL_PROCESS] ========================================")
(princ "\n[BTI_FULL_PROCESS] ✅ ОБРАБОТКА ЗАВЕРШЕНА УСПЕШНО")
(princ "\n[BTI_FULL_PROCESS] ========================================")

; Шаг 4: Сохранение результата
QSAVE

